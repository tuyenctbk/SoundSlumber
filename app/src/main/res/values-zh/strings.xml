    <string name="gentle_wake_mode">柔和唤醒模式</string>
    <string name="gentle_wake_desc">在睡眠定时器结束时，在5分钟内逐渐调高音量，帮您温柔地苏醒。</string>
    <string name="rise_and_shine">晨光初现，准备起床</string>

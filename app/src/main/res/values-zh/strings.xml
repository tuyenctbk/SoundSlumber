<resources>
    <string name="app_name">SoundSlumber</string>
    <string name="power_save_mode">省电模式</string>
    <string name="power_save_desc">降低音频采样率并禁用播放期间非必要的界面动画，以节省夜间电量。</string>
    <string name="loudness_normalization">音量均衡</string>
